# Stage 2: GPIOA_1 (header pin 2), FPGA V1. Connect B OUT to A IN and common GND.
set_pin_assignment { stereo_sync_o } { LOCATION = V1; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

# Fire control on B board, 2026-10-05. Enabled for the documented J1 wiring.
# J1 pin 4 = GPIOA_3 = U1, J1 pin 5 = GPIOA_4 = T4, BANK21 VCCIO = 3.3 V.
# Existing J1 pins 1/2/3 are car RX / stereo sync / car TX; do not reuse.
set_pin_assignment { servo_pwm_out } { LOCATION = U1; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { pump_ctrl_out } { LOCATION = T4; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
# For an active-low MOS input, set FIRE_PUMP_ACTIVE_HIGH=0 and use PULLUP instead.

# Manual pump test: schematic SW2 -> SW1 net -> FPGA B4, BANK42 VCCIO 3.3 V.
# ON is input low by default; observe stable OFF after reset before enabling.
set_pin_assignment { I_pump_test_switch } { LOCATION = B4; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# US-100 jumper-present UART. J1 pin 6 = GPIOA_5/T3, pin 7 = GPIOA_6/T2.
# Use 3.3 V sensor power: J1 pin 29. GND: J1 pin 30 (or 12).
# FPGA TX -> sensor Trig/TX input; sensor Echo/RX output -> FPGA RX.
# set_pin_assignment { us100_uart_tx_out } { LOCATION = T3; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
# set_pin_assignment { us100_uart_rx_in } { LOCATION = T2; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# HC-SR04 2020 default GPIO trial, replacing the commented US-100 interface.
# Keep J1 pins 6/7, 3.3 V at pin 29 and GND at pin 30 (or 12).
# Trig/Echo are idle-low; RX pulldown gives a timeout if the sensor is unplugged.
set_pin_assignment { hcsr04_trig_out } { LOCATION = T3; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
set_pin_assignment { hcsr04_echo_in } { LOCATION = T2; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
