# Stage 2: GPIOA_1 (header pin 2), FPGA V1. Connect B OUT to A IN and common GND.
set_pin_assignment { stereo_sync_i } { LOCATION = V1; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }

# MAX30102 I2C on A/NPU board header; match B-board sensor wiring.
